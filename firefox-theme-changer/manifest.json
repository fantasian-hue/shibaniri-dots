{
  "manifest_version": 3,
  "name": "Theme Sync (Live CSS)",
  "version": "2.0",
  "description": "Live-injects colors.css into every open tab and future tabs, no reload required.",
  "browser_specific_settings": {
    "gecko": {
      "id": "theme-sync@local.script"
    }
  },
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  }
}
